{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Docs | Elk Agent",
  "icons": {
    "library": "tabler"
  },
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#18181B"
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "icon": "layout-dashboard",
          "href": "https://elkagent.com/dashboard"
        },
        {
          "anchor": "Community",
          "icon": "discord",
          "href": "https://discord.gg/wfEQBe4p"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index"]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "git-branch",
        "groups": [
          {
            "group": "Changelog",
            "pages": ["changelog/index"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://elkagent.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://elkagent.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/elkagent",
      "discord": "https://discord.gg/wfEQBe4p",
      "linkedin": "https://linkedin.com/company/elkagent"
    }
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    },
    "decoration": "grid"
  },
  "fonts": {
    "family": "Geist"
  }
}
